@page "/runs"
@inject ApiClient Api

<PageTitle>Runs | SelfBet</PageTitle>

<div class="page-header"><h1>Runs</h1></div>

@if (runs is null)
{
    <p class="loading">Loading...</p>
}
else if (runs.Count == 0)
{
    <div class="empty-state">No runs recorded yet.</div>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Started</th>
                <th>Trigger</th>
                <th>Status</th>
                <th>Fixtures</th>
                <th>Candidates</th>
                <th>Slips</th>
                <th>Message</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in runs)
        {
            <tr>
                <td>@r.StartedAtUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                <td><span class="market-badge">@r.Trigger</span></td>
                <td><span class="badge badge-@r.Status.ToLower()">@r.Status</span></td>
                <td>@r.FixturesEvaluated</td>
                <td>@r.CandidatesGenerated</td>
                <td><strong>@r.SlipsBuilt</strong></td>
                <td class="muted">@r.Message</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<RunDto>? runs;

    protected override async Task OnInitializedAsync()
    {
        runs = await Api.GetRunsAsync(50) ?? [];
    }
}
