@page "/audit"
@inject ApiClient Api

<PageTitle>Audit | SelfBet</PageTitle>

<div class="page-header"><h1>Audit Trail</h1></div>

@if (events is null)
{
    <p class="loading">Loading...</p>
}
else if (events.Count == 0)
{
    <div class="empty-state">No audit events yet.</div>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Time</th>
                <th>Type</th>
                <th>Message</th>
                <th>Metadata</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var e in events)
        {
            <tr>
                <td>@e.OccurredAtUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td><span class="market-badge">@e.EventType</span></td>
                <td>@e.Message</td>
                <td class="muted" style="font-family: 'JetBrains Mono', monospace; font-size: 0.78rem;">@e.MetadataJson</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<AuditEventDto>? events;

    protected override async Task OnInitializedAsync()
    {
        events = await Api.GetAuditEventsAsync(200) ?? [];
    }
}
