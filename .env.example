# ── SelfBet production secrets ── COPY TO .env AND FILL IN ──────────────

# Neon Postgres (get from console.neon.tech → your project → Connection Details)
CONNECTIONSTRINGS__DEFAULTCONNECTION=postgresql://user:password@host/db?sslmode=require

# SportyBet account
SPORTYBET__PHONE=<your Nigeria mobile number, e.g. 08012345678>
SPORTYBET__PASSWORD=<your SportyBet password>
SPORTYBET__PLACEMENTMODE=booking_code   # or full_auth to auto-stake

# SMTP — Gmail recommended (use App Password from myaccount.google.com/apppasswords)
SMTP__ENABLED=true
SMTP__HOST=smtp.gmail.com
SMTP__PORT=587
SMTP__USERNAME=you@gmail.com
SMTP__PASSWORD=xxxx xxxx xxxx xxxx
SMTP__TO=you@gmail.com
SMTP__DASHBOARDURL=https://your-selfbet-dashboard.onrender.com

# ASP.NET
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
